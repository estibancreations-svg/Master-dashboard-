{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A workspace project representing a VisionWeaver workflow run",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "production"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "n8nWebhookUrl": { "type": "string" },
        "driveAttachments": { "type": "array" },
        "selectedChatSpaceId": { "type": "string" }
      },
      "required": ["id", "name", "userId", "createdAt"]
    },
    "Pipeline": {
      "title": "Pipeline",
      "description": "VisionWeaver pipeline configuration for a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "nodes": { "type": "array" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "nodes", "userId"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Log of alerts sent to Google Chat workspace spaces",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "spaceId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "message", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of projects grouped by ID"
    },
    "/pipelines/{pipelineId}": {
      "schema": "Pipeline",
      "description": "List of pipeline setups for projects"
    },
    "/notificationLogs/{logId}": {
      "schema": "NotificationLog",
      "description": "Lists notifications triggered"
    }
  }
}
